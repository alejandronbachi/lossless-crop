QWidget#SettingsDrawer {
    background-color: rgba(20, 20, 20, 0.94);
    border-left: 1px solid rgba(255, 255, 255, 0.15);
}
QCheckBox {
    color: #e0e0e0;
    font-size: 13px;
    padding: 4px;
}
QLabel {
    color: #ffffff;
    font-size: 14px;
    font-weight: bold;
    padding-bottom: 5px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}