/* ============================================================================
   LossLess Crop - Master Application Stylesheet Template
   ============================================================================ */

/* --- 1. GLOBAL WINDOW & TYPOGRAPHY FOUNDATIONS --- */
QMainWindow, QMainWindow > QWidget {
    background-color: @WINDOW_BG;
}

/* Consolidated typography rule mapping straight to your original drawer checkbox text token */
QLabel, QCheckBox, QPushButton, QComboBox, QSpinBox {
    font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
    color: @DRAWER_CHECKBOX_TEXT;
}



/* --- 2. GLOBAL WIDGET COMPONENT DEFINITIONS (FROM main.qss mapped to original tokens) --- */
QLabel {
    background-color: @SPIN_BG;              /* Dynamically maps to your dark/light container backgrounds */
    border: 1px solid @SPIN_BORDER;          /* Dynamically maps to your standard border colors */
    border-radius: 4px;
}

QLabel:focus {
    border: 1px solid @PRIMARY_ACCENT;       /* Dynamically maps to your primary active accent color */
}

/* Interactive PushButtons */
QPushButton {
    background-color: @SPIN_BG;              /* Inherits your spinbox base background color token */
    border: 1px solid @SPIN_BORDER;          /* Inherits your spinbox standard border token */
    border-radius: 4px;
    color: @SPIN_TEXT;                       /* Inherits your spinbox typography color token */
    padding: 5px 12px;
    font-size: 13px;
    font-weight: normal;
}
QPushButton:hover {
    background-color: @SPIN_BTN_HOVER;       /* Inherits your soft shading button hover state token */
    border: 1px solid @SPIN_BORDER_HOVER;    /* Inherits your focus border highlight token */
}
QPushButton:pressed {
    background-color: @SPIN_BTN_PRESSED;     /* Inherits your solid pressed background state token */
    border: 1px solid @SPIN_BORDER;
}
QPushButton:focus {
    border: 1px solid @PRIMARY_ACCENT;       /* Inherits your precise system accent highlight token */
    background-color: @SPIN_FOCUS_BG;        /* Inherits your subtle focus container accent color */
    outline: none;
}

/* Interactive Dropdown ComboBoxes */
QComboBox, .QComboBox {
    background-color: @SPIN_BG;
    border: 1px solid @SPIN_BORDER;
    border-radius: 4px;
    padding: 4px 25px 4px 10px;
    color: @SPIN_TEXT;
    min-width: 100px;
}
QComboBox:hover, .QComboBox:hover {
    border: 1px solid @SPIN_BORDER_HOVER;
}
QComboBox:focus, .QComboBox:focus {
    border: 1px solid @PRIMARY_ACCENT;
    background-color: @SPIN_FOCUS_BG;
    outline: none;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left-width: 0px;
}
QComboBox QAbstractItemView, .QComboBox QAbstractItemView {
    background-color: @SPIN_BG;
    border: 1px solid @SPIN_BORDER;
    selection-background-color: @PRIMARY_ACCENT;
    selection-color: @SPIN_TEXT;
    color: @DRAWER_CHECKBOX_TEXT;
}

/* Bottom Split Information Framework */
QWidget#info_bar_widget {
    background-color: @SPIN_BTN_PRESSED;     /* Inherits your deep resting element background token */
    border-top: 1px solid @SPIN_BORDER;
}

/* --- 3. THE REFACTORED CHECKBOX STRUCTURE (Fixed Outline and Hover Glitches) --- */
QCheckBox {
    font-size: 13px;
    spacing: 10px;
    background-color: transparent;
}

/* --- 4. INDIVIDUAL MODULAR BLOCKS --- */
/* Settings Gear Icon Button (btn_settings.qss) */
QPushButton#btnSettings {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    font-size: 16px; 
    color: @BTN_SETTINGS_COLOR;
    padding: 0px;   
    margin: 0px;
}
QPushButton#btnSettings:hover {
    background-color: @BTN_SETTINGS_HOVER_BG;
    color: @BTN_SETTINGS_HOVER_COLOR;
}
QPushButton#btnSettings:pressed {
    background-color: @BTN_SETTINGS_PRESSED_BG;
}
QPushButton#btnSettings:focus {
    background-color: @BTN_SETTINGS_FOCUS_BG;
    border: 1px solid @PRIMARY_ACCENT;
    color: @BTN_SETTINGS_FOCUS_COLOR;
    outline: none;
}

/* Command Shortcuts Panel Overlay (commands_overlay.qss) */
QLabel#CommandsOverlay, QWidget#CommandsOverlay, .CommandsOverlay {
    color: @COMMANDS_TEXT;
    font-family: monospace;
    font-size: 13px;
    font-weight: bold;
    background-color: @COMMANDS_BG;
    border: 1px solid @COMMANDS_BORDER;
    border-radius: 6px;
    padding: 10px;
}

/* Settings Drawer Sliding Widget Framework (drawer.qss) */
QWidget#SettingsDrawer {
    background-color: @DRAWER_BG;
    border-left: 1px solid @DRAWER_BORDER;
}
QWidget#SettingsDrawer QCheckBox {
    color: @DRAWER_CHECKBOX_TEXT;
    font-size: 13px;
    padding: 4px;
}
QWidget#SettingsDrawer QLabel {
    color: @DRAWER_LABEL_TEXT;
    font-size: 14px;
    font-weight: bold;
    padding-bottom: 5px;
    border-bottom: 1px solid @DRAWER_LABEL_BORDER;
}

/* Floating Cinematic Notifications Panel (notification.qss) */
QLabel#NotificationOverlay, QWidget#NotificationOverlay, .CenterNotification, .NotificationOverlay {
    color: @NOTIF_TEXT;
    font-size: 28px;
    font-weight: bold;
    background-color: @NOTIF_BG;
    border: 2px solid @NOTIF_BORDER;
    border-radius: 12px;
    padding: 15px 30px;
}

/* Metrics Tracking HUD (telemetry_hud.qss) */
QLabel#TelemetryHUD, .TelemetryHUD {
    color: @TELEMETRY_TEXT;
    font-family: monospace;
    font-size: 13px;
    font-weight: bold;
    background-color: @TELEMETRY_BG;
    border: 1px solid @TELEMETRY_BORDER;
    border-radius: 6px;
    padding: 10px;
}

/* Launch Guidelines HUD (splash_hud.qss) */
QLabel#SplashHUD, .SplashHUD {
    color: @SPLASH_TEXT !important;
    font-family: 'Segoe UI', -apple-system, sans-serif;
    background-color: @SPLASH_BG;
    border: 1px solid @SPLASH_BORDER;
    border-radius: 12px;
    padding: 35px 50px;
    line-height: 150%;
}

/* Row Containers (ControlToolbar.qss) */
QToolBar, ControlToolbar, .ControlToolbar {
    background-color: transparent;
    border: none;
    margin: 0px;
    padding: 0px;
}

/* Numerical Core Controllers (spinboxes.qss) */
QSpinBox {
    background-color: @SPIN_BG;
    border: 1px solid @SPIN_BORDER;
    border-radius: 4px;
    color: @SPIN_TEXT;
    font-family: monospace;
    font-size: 13px;
    font-weight: normal;
    min-width: 95px;
}
QSpinBox:hover {
    border: 1px solid @SPIN_BORDER_HOVER;
}
QSpinBox::editor {
    background-color: @SPIN_BG;
    color: @SPIN_TEXT;
    font-weight: normal;
    padding-top: 3px;
    padding-bottom: 3px;
    padding-left: 5px;
    padding-right: 20px; 
}
QSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 18px;
    height: 12px; 
    border-left: 1px solid @SPIN_BTN_BORDER;
    border-bottom: 1px solid @SPIN_BTN_BORDER;
    background-color: @SPIN_BTN_BG;
}
QSpinBox::up-button:hover {
    background-color: @SPIN_BTN_HOVER;
}
QSpinBox::up-button:pressed {
    background-color: @SPIN_BTN_PRESSED;
}
QSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 18px;
    height: 12px; 
    border-left: 1px solid @SPIN_BTN_BORDER;
    background-color: @SPIN_BTN_BG;
}
QSpinBox::down-button:hover {
    background-color: @SPIN_BTN_HOVER;
}
QSpinBox::down-button:pressed {
    background-color: @SPIN_BTN_PRESSED;
}
QSpinBox::up-arrow {
    image: @SPIN_UP_ARROW;
    width: 10px;
    height: 10px;
}
QSpinBox::down-arrow {
    image: @SPIN_DOWN_ARROW;
    width: 10px;
    height: 10px;
}
QSpinBox:focus {
    border: 1px solid @PRIMARY_ACCENT;
    background-color: @SPIN_FOCUS_BG;
}

/* --- 5. REFACTORED INLINE LAYOUT PROPERTIES --- */
QPushButton#btnFolder {
    font-weight: normal; 
    color: @LBL_FOLDER_TEXT; 
    margin-left: 5px; 
    min-width: 140px; 
    text-align: left;
    background-color: transparent; 
    border: none;
}
QPushButton#btnFolder:hover {
    color: @PRIMARY_ACCENT;
}

QWidget#spinContainer {
    background-color: transparent; 
    border: none; 
    margin: 0; 
    padding: 0;
}

QLabel#lblCanvas {
    background-color: @CANVAS_BG; 
    border: 2px solid @CANVAS_BORDER;
}

QLabel#lblStatus { 
    color: @LBL_STATUS_TEXT; 
    font-size: 15px; 
    font-weight: normal;
    background-color: transparent;
    border: none;
}

QLabel#lblMetrics {
    color: @LBL_METRICS_TEXT; 
    font-family: monospace; 
    font-size: 13px; 
    font-weight: normal;
    background-color: transparent;
    border: none;
}

QFrame#divider {
    background-color: @DIVIDER_COLOR; 
    margin-bottom: 5px;
}

QLabel.sectionHeading {
    color: @SECTION_HEAD_TEXT; 
    font-size: 11px; 
    font-weight: bold; 
    text-transform: uppercase; 
    letter-spacing: 1px; 
    border: none; 
background-color: transparent;
padding-bottom: 2px;
}
QLabel#lblAutoSection { margin-top: 15px; }
QLabel#lblShowSection { margin-top: 10px; }
QLabel#lblLayoutSection { margin-top: 15px; }
QMenuBar {
        background-color: transparent;
        margin: 0px;
        padding: 0px;
        spacing: 5px; /* Space between 'File' and 'Help' text horizontally */
    }
QMenuBar::item {
    padding: 2px 6px; /* Tight vertical padding (2px top/bottom, 6px left/right) */
    margin: 0px;
    background: transparent;
}