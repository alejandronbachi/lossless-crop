/* ============================================================================
   LossLess Crop - Master Application Stylesheet Template
   ============================================================================ */

/* --- GLOBAL APP SPECIFICS --- */
QWidget {
    font-family: 'Segoe UI', -apple-system, sans-serif;
}

QMainWindow, QMainWindow > QWidget {
    background-color: @WINDOW_BG;
}

/* --- FROM: btn_settings.qss --- */
QPushButton#btnSettings {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    font-size: 16px; 
    color: @BTN_SETTINGS_COLOR;
    padding: 0px;   
    margin: 0px;
}
QPushButton#btnSettings:hover {
    background-color: @BTN_SETTINGS_HOVER_BG;
    color: @BTN_SETTINGS_HOVER_COLOR;
}
QPushButton#btnSettings:pressed {
    background-color: @BTN_SETTINGS_PRESSED_BG;
}
QPushButton#btnSettings:focus {
    background-color: @BTN_SETTINGS_FOCUS_BG;
    border: 1px solid @PRIMARY_ACCENT;
    color: @BTN_SETTINGS_FOCUS_COLOR;
    outline: none;
}

/* --- FROM: commands_overlay.qss --- */
QLabel#CommandsOverlay, QWidget#CommandsOverlay, .CommandsOverlay {
    color: @COMMANDS_TEXT;
    font-family: monospace;
    font-size: 13px;
    font-weight: bold;
    background-color: @COMMANDS_BG;
    border: 1px solid @COMMANDS_BORDER;
    border-radius: 6px;
    padding: 10px;
}

QCheckBox {
    color: @DRAWER_CHECKBOX_TEXT;
    font-size: 13px;
    padding: 4px;
}

/* Customize the tiny selection box layer indicators */
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid @SPIN_BORDER;
    border-radius: 4px;
    background-color: @SPIN_BG;
}

QCheckBox::indicator:hover {
    border: 1px solid @SPIN_BORDER_HOVER;
}

QCheckBox::indicator:checked {
    background-color: @PRIMARY_ACCENT;
    border: 1px solid @PRIMARY_ACCENT;
    /* Native geometric checkmark shape marker */
    image: url(data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgc3Ryb2tlPSJ3aGl0ZSIgc3Ryb2tlLXdpZHRoPSI0IiBzdHJva2UtbGluZWNhcD0icm91bmQiPjxwb2x5bGluZSBwb2ludHM9IjIwIDYgOSAxNyA0IDEyIi8+PC9zdmc+);
}

/* --- FROM: drawer.qss (Keep your original explicit nesting safe) --- */
QWidget#SettingsDrawer {
    background-color: @DRAWER_BG;
    border-left: 1px solid @DRAWER_BORDER;
}
QWidget#SettingsDrawer QCheckBox {
    color: @DRAWER_CHECKBOX_TEXT;
    font-size: 13px;
    padding: 4px;
}
QWidget#SettingsDrawer QLabel {
    color: @DRAWER_LABEL_TEXT;
    font-size: 14px;
    font-weight: bold;
    padding-bottom: 5px;
    border-bottom: 1px solid @DRAWER_LABEL_BORDER;
}

/* --- FROM: notification.qss --- */
/* Fixed: Target the overlay element directly whether it's a raw QLabel subclass or wrapped */
QLabel#NotificationOverlay, QWidget#NotificationOverlay, .CenterNotification, .NotificationOverlay {
    color: @NOTIF_TEXT;
    font-size: 28px;
    font-weight: bold;
    background-color: @NOTIF_BG;
    border: 2px solid @NOTIF_BORDER;
    border-radius: 12px;
    padding: 15px 30px;
}

/* --- FROM: telemetry_hud.qss --- */
QLabel#TelemetryHUD, .TelemetryHUD {
    color: @TELEMETRY_TEXT;
    font-family: monospace;
    font-size: 13px;
    font-weight: bold;
    background-color: @TELEMETRY_BG;
    border: 1px solid @TELEMETRY_BORDER;
    border-radius: 6px;
    padding: 10px;
}

/* --- FROM: splash_hud.qss --- */
QLabel#SplashHUD, .SplashHUD {
    color: @SPLASH_TEXT !important;
    font-family: 'Segoe UI', -apple-system, sans-serif;
    background-color: @SPLASH_BG;
    border: 1px solid @SPLASH_BORDER;
    border-radius: 12px;
    padding: 35px 50px;
    line-height: 150%;
}

/* --- TOOLBARS & BOTTOM INFO BARS --- */
/* Fixed: Forces custom classes like ControlToolbar to inherit background & boundary color traits */
QToolBar, ControlToolbar, .ControlToolbar, QStatusBar, #bottomInfoBar {
    background-color: @DRAWER_BG;
    border: none;
    border-bottom: 1px solid @DRAWER_BORDER;
}

/* --- COMBO BOXES & DROP DOWN VIEWS --- */
/* Fixed: Fully maps custom combo setups alongside native dropdown frameworks */
QComboBox, .QComboBox {
    background-color: @SPIN_BG;
    border: 1px solid @SPIN_BORDER;
    border-radius: 4px;
    color: @SPIN_TEXT;
    padding: 3px 7px;
}
QComboBox:hover, .QComboBox:hover {
    border: 1px solid @SPIN_BORDER_HOVER;
}
QComboBox:focus, .QComboBox:focus {
    border: 1px solid @PRIMARY_ACCENT;
}
/* Crucial: Styles the independent popping menu container layers where items live */
QComboBox QAbstractItemView, .QComboBox QAbstractItemView {
    background-color: @SPIN_BG;
    border: 1px solid @SPIN_BORDER;
    color: @SPIN_TEXT;
    selection-background-color: @PRIMARY_ACCENT;
    selection-color: @SPIN_TEXT;
}

/* --- FROM: spinboxes.qss --- */
QSpinBox {
    background-color: @SPIN_BG;
    border: 1px solid @SPIN_BORDER;
    border-radius: 4px;
    color: @SPIN_TEXT;
    font-family: monospace;
    font-size: 13px;
    font-weight: normal; /* 🌟 Fixed: Changed from Bold to Normal for layout coherence */
    min-width: 95px;
}
QSpinBox:hover {
    border: 1px solid @SPIN_BORDER_HOVER;
}
QSpinBox::editor {
    background-color: @SPIN_BG;
    color: @SPIN_TEXT;
    font-weight: normal; /* 🌟 Fixed: Standardized input cursor layer weight */
    padding-top: 3px;
    padding-bottom: 3px;
    padding-left: 5px;
    padding-right: 20px; 
}
QSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 18px;
    height: 12px; 
    border-left: 1px solid @SPIN_BTN_BORDER;
    border-bottom: 1px solid @SPIN_BTN_BORDER;
    background-color: @SPIN_BTN_BG;
}
QSpinBox::up-button:hover {
    background-color: @SPIN_BTN_HOVER;
}
QSpinBox::up-button:pressed {
    background-color: @SPIN_BTN_PRESSED;
}
QSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 18px;
    height: 12px; 
    border-left: 1px solid @SPIN_BTN_BORDER;
    background-color: @SPIN_BTN_BG;
}
QSpinBox::down-button:hover {
    background-color: @SPIN_BTN_HOVER;
}
QSpinBox::down-button:pressed {
    background-color: @SPIN_BTN_PRESSED;
}
QSpinBox::up-arrow {
    image: @SPIN_UP_ARROW;
    width: 10px;
    height: 10px;
}
QSpinBox::down-arrow {
    image: @SPIN_DOWN_ARROW;
    width: 10px;
    height: 10px;
}
QSpinBox:focus {
    border: 1px solid @PRIMARY_ACCENT;
    background-color: @SPIN_FOCUS_BG;
}

/* --- FROM: inline styles refactored into master selectors --- */
/* 🌟 Renamed from QLabel#lblFolder to QPushButton#btnFolder and standardized weight */
QPushButton#btnFolder {
    font-weight: normal; /* 🌟 Fixed: Removed Bold property to seamlessly blend with Combos */
    color: @LBL_FOLDER_TEXT; 
    margin-left: 5px; 
    min-width: 140px; 
    text-align: left;
    background-color: transparent; /* Keep it look clean like text but behave like a link button */
    border: none;
}

QWidget#spinContainer {
    background-color: transparent; 
    border: none; 
    margin: 0; 
    padding: 0;
}

QLabel#lblCanvas {
    background-color: @CANVAS_BG; 
    border: 2px solid @CANVAS_BORDER;
}

QLabel#lblStatus { 
    color: @LBL_STATUS_TEXT; 
    font-size: 15px; 
    font-weight: normal; /* 🌟 Fixed: Changed from 500 to normal for clean typography matching */
}

QLabel#lblMetrics {
    color: @LBL_METRICS_TEXT; 
    font-family: monospace; 
    font-size: 13px; 
    font-weight: normal; /* 🌟 Fixed: Dropped bold constraint across system matrix values */
}

QFrame#divider {
    background-color: @DIVIDER_COLOR; 
    margin-bottom: 5px;
}

QLabel.sectionHeading {
    color: @SECTION_HEAD_TEXT; 
    font-size: 11px; 
    font-weight: bold; /* Note: We keep section category headers bold since they serve as static structural labels */
    text-transform: uppercase; 
    letter-spacing: 1px; 
    border: none; 
    padding-bottom: 2px;
}

QLabel#lblAutoSection { margin-top: 15px; }
QLabel#lblShowSection { margin-top: 10px; }
QLabel#lblLayoutSection { margin-top: 15px; }
